# App (server-only — never expose APP_ENV via NEXT_PUBLIC_*)
APP_ENV=production
# APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FIREBASE KEYS
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only — download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# SUPABASE KEYS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only — Supabase Dashboard > Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=

# Cron scheduler (server-only — protect GET /api/cron/daily-runner)
CRON_SECRET=

# Upstash Redis (server-only — API rate limiting firewall)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# VAPI AI Voice (production)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# WhatsApp / UPI (production)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Secret (server-only) — App Dashboard > Settings > Basic > App Secret.
# Required: inbound webhooks are rejected with 401 when this is unset.
META_APP_SECRET=
# Arbitrary shared string echoed during Meta's webhook subscription handshake.
META_WHATSAPP_VERIFY_TOKEN=
DEFAULT_MERCHANT_UPI_VPA=
# Force real Meta WhatsApp API calls during local testing (requires credentials above).
# TEST_REAL_WHATSAPP_LOCALLY=true

# Analytics — GA4 (client + server Measurement Protocol)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-9X4LWG7Q94
GA4_MEASUREMENT_PROTOCOL_SECRET=

# Meta Pixel (client-side page views)
NEXT_PUBLIC_META_PIXEL_ID=

# --- Error tracking (Sentry) ---
# All optional: with no DSN the SDK stays inert and the app behaves as before.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps during the build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Razorpay (production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PREMIUM_MONTHLY=
RAZORPAY_PLAN_PREMIUM_MONTHLY_DISCOUNTED=
RAZORPAY_PLAN_PREMIUM_ANNUAL=

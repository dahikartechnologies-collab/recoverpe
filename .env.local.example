NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only — Supabase Dashboard > Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=

# Cron scheduler (server-only — protect GET /api/cron/daily-runner)
CRON_SECRET=

# VAPI AI Voice (production)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# WhatsApp / UPI (production)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
DEFAULT_MERCHANT_UPI_VPA=

# Razorpay (production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
